# Kopieren nach .env (wird nicht eingecheckt)
PARQET_CLIENT_ID=
# nur falls deine Integration ein Secret hat (vertrauliche Clients)
PARQET_CLIENT_SECRET=
PARQET_REDIRECT_URI=http://localhost:5173/auth/callback
# Standardwerte, nur bei Bedarf ändern
# PARQET_AUTH_URL=https://connect.parqet.com/oauth2/authorize
# PARQET_TOKEN_URL=https://connect.parqet.com/oauth2/token
# PARQET_API_BASE=https://connect.parqet.com
PORT=5173
